{
    "name": "dynamic/silverstripe-elemental-aos",
    "description": "Per-element scroll-reveal animations (AOS) for Silverstripe Elemental blocks.",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "elemental",
        "aos",
        "animation"
    ],
    "require": {
        "php": "^8.3",
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/framework": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^11",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/standards": "^1",
        "squizlabs/php_codesniffer": "^3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\Elemental\\AOS\\": "src/",
            "Dynamic\\Elemental\\AOS\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    }
}
